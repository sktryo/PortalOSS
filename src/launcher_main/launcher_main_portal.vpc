// Keep the base name equal to the mod directory (game/portal) so the
// launcher's executable-name based default game resolution works.
$Macro OUTBINNAME "portal"

$Conditional "MOD_LAUNCHER" "1"

$Include "launcher_main.vpc"

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions	"$BASE;MOD_APPID=400" // Portal's Steam appid
	}
}

$Project "Launcher Main (Portal)"
{
    $Folder "Resource Files" [$WINDOWS]
    {
        $File   "launcher_main_portal.rc"
        $File   "res\mod_portal.ico"
    }
}
